# Example configuration for startup FROM THE REPOSITORY ROOT.
# Copy to a local .env, edit as needed, and load it in the prepared Jetson
# environment with Bash. The Python application does not load .env itself:
#   set -a
#   . ./.env
#   set +a
#   python3 jetson-code/main.py
# impl.yaml's run command also loads a local .env when present.
# Real credentials belong only in ignored local configuration, never here.
# Configure ESP32 Wi-Fi credentials locally with idf.py menuconfig.

# Required model path, relative to the repository root (or use an absolute path).
# Keep model_meta.json next to the model.
MODEL_PATH=jetson-code/models/action_3word_noface.h5
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# Local video receiver. These non-secret example settings match the sender.
HOST=0.0.0.0
PORT=5000
PAYLOAD_FORMAT=h264

# Keep every decoded frame for the current 15 FPS capture output.
# Use 2 instead when receiving a 30 FPS stream for the same effective timing.
FRAME_STRIDE=1
PAYLOAD_QUEUE_SIZE=64
DECODED_QUEUE_SIZE=2
STATS_INTERVAL_SEC=5

# Optional browser preview on the same local network.
PREVIEW_HTTP=1
PREVIEW_PORT=8000
PREVIEW_FPS=30
PREVIEW_WIDTH=640
PREVIEW_JPEG_QUALITY=75
PREVIEW_LANDMARKS=1
PREVIEW_MAX_SENTENCE=5

# Processing settings not supplied by model_meta.json.
PARALLEL_MEDIAPIPE=1
INFER_WIDTH=640
REPEAT_RESET=15

# Optional model overrides. Leave these commented to use model_meta.json.
# The example values below describe the currently supplied three-word model.
# ACTIONS=hello,thanks,iloveyou
# SEQUENCE_LENGTH=20
# FRAME_SIZE=640x360
# MODEL_COMPLEXITY=0
# MIN_HAND_FRAC=0.8
# THRESHOLD=0.85
# STABLE_N=12
