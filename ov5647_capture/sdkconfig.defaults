# Seeed XIAO ESP32-S3 Sense (typical SKU: 8MB flash + 8MB OPI PSRAM).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# TCP streaming Wi-Fi defaults (set real credentials via `idf.py menuconfig`).
CONFIG_ESP_WIFI_REMOTE_SSID="YOUR_SSID"
CONFIG_ESP_WIFI_REMOTE_PASSWORD="YOUR_PASSWORD"
CONFIG_ESP_WIFI_REMOTE_MAX_RETRIES=5
