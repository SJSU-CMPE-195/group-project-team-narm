# ESP32-P4 uses Wi-Fi via co-processor (esp_hosted); host must enable this so
# esp_wifi_remote links esp_wifi_remote_net2.c (incl. esp_wifi_remote_create_default_sta).
CONFIG_ESP_HOST_WIFI_ENABLED=y

# P4 has no CONFIG_SOC_WIFI_HE_SUPPORT, so esp_wifi_he_types.h is not included on the host.
# esp_hosted iTWT RPC references wifi_twt_* / wifi_itwt_* types; disable ITWT on host build.
CONFIG_ESP_HOSTED_ENABLE_ITWT=n
